# CiliaMiner backend environment variables.
# Copy to `.env` for local runs (the real .env is gitignored).

# Required by the weekly publications ingestion job (summarization).
# In CI this is provided via the DEEPSEEK_API_KEY GitHub Actions secret.
DEEPSEEK_API_KEY=

# Optional overrides (defaults live in app/config.py):
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com
